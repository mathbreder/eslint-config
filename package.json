{
  "name": "@mathbreder/eslint-config",
  "version": "0.0.10",
  "private": false,
  "description": "ESLint configuration used by mathbreder.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react-refresh-vite": {
      "import": {
        "types": "./dist/eslint-configs/react-refresh-vite.d.ts",
        "default": "./dist/eslint-configs/react-refresh-vite.js"
      },
      "require": {
        "types": "./dist/eslint-configs/react-refresh-vite.d.cts",
        "default": "./dist/eslint-configs/react-refresh-vite.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/eslint-configs/next.d.ts",
        "default": "./dist/eslint-configs/next.js"
      },
      "require": {
        "types": "./dist/eslint-configs/next.d.cts",
        "default": "./dist/eslint-configs/next.cjs"
      }
    },
    "./expo": {
      "import": {
        "types": "./dist/eslint-configs/expo.d.ts",
        "default": "./dist/eslint-configs/expo.js"
      },
      "require": {
        "types": "./dist/eslint-configs/expo.d.cts",
        "default": "./dist/eslint-configs/expo.cjs"
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepack": "pnpm run build",
    "clean": "pnpx rimraf dist",
    "prebuild": "pnpm run clean",
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "pretest": "pnpm run build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:consumers": "node tests/consumers/run.mjs"
  },
  "license": "MIT",
  "repository": {
    "url": "mathbreder/eslint-config"
  },
  "peerDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.35.0",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "typescript": ">=4.8.4 <6.1.0",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint-config-expo": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.22",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
